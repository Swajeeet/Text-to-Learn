# ─────────────────────────────────────────────────────────────────────────────
# Text-to-Learn — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000

# Database — MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/text-to-learn?retryWrites=true&w=majority

# Authentication — JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# AI — OpenRouter API
# Get this from: https://openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
